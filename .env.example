# Database
DATABASE_URL=postgresql://user:password@host:5432/niche_watcher

# Email Bot (Gmail SMTP)
EMAIL_BOT_ADDRESS=niche.watcher.bot@gmail.com
EMAIL_BOT_PASSWORD=your_app_password_here

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS
FRONTEND_URL=https://your-domain.com

# Environment
ENVIRONMENT=production

# Auth - IMPORTANT: Change this to a strong secret key!
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
