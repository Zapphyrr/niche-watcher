{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "web": {
      "build": {
        "builder": "nixpacks"
      },
      "deploy": {
        "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT"
      }
    },
    "worker": {
      "build": {
        "builder": "nixpacks"
      },
      "deploy": {
        "startCommand": "python scheduler.py --loop"
      }
    },
    "nixpacks": {
    "providers": ["python"]
    }
  }
}
